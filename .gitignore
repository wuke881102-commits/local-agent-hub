backend/.venv/
backend/.pytest_cache/
backend/data/*.sqlite
backend/data/*.sqlite-journal
backend/data/drafts/
backend/data/*.log
backend/data/*.json
# 全量忽略运行时数据目录（含「自动化提炼」截图与 digests.jsonl 等用户数据，绝不提交）
backend/data/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Original design / source materials (kept out of build artifacts)
Feishu.zip
Feishu_design/

# ── Build artifacts & large binaries (regenerable; keep repo lean) ──
/dist-installer/
/backend/dist/
/backend/build/
/build/stage/
/build/tools/*.zip

# ── Secrets in PLAINTEXT — never commit. Only the encrypted secrets.7z is tracked. ──
/build/production.env
/build/stage/backend/.env
# backend/.env already ignored above

# ── Repo-root runtime data (dev server writes here; may contain tokens / logs) ──
/data/
